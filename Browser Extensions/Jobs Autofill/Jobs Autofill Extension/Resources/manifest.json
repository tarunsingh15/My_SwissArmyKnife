{
  "manifest_version": 3,
  "name": "Job App Autofill",
  "version": "0.1.0",
  "description": "Autofills job applications with role-based profiles and resume selection while stopping for manual review.",
  "default_locale": "en",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.greenhouse.io/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.smartrecruiters.com/*",
    "https://*/*"
  ],
  "commands": {
    "run-autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Run autofill on current page"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "action": {
    "default_title": "Job App Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "96": "images/icon-96.png",
      "128": "images/icon-128.png",
      "256": "images/icon-256.png",
      "512": "images/icon-512.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
